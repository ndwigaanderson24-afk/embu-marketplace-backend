{
  "name": "embu-marketplace-backend",
  "version": "1.0.0",
  "description": "Backend API for Embu Marketplace - matches the actual website's data model (unified users/sellers, cart, multi-seller order splitting, referral codes, county-based delivery pricing).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "mysql -u root -p < sql/schema.sql",
    "db:seed": "node seed.js"
  },
  "dependencies": {
    "agora-token": "^2.0.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "intasend-node": "^1.1.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
